\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Reserved for the structure factor at the parameters of Fig.~\ref {fig:ffSnapshot}. Use $S(\mathbf  k)=N^{-1}\langle |\DOTSB \sum@ \slimits@ _j e^{-\mathrm  i\mathbf  k\cdot \mathbf  r_j}|^2\rangle $ for nonzero periodic wavevectors $\mathbf  k=2\pi (n_x,n_y)/L$. Radial bins should average per-mode values, not sum them: in two dimensions a shell sum can itself introduce a factor proportional to $k$. State the time averaging, bin widths, uncertainty estimates, and fitted wave-number interval. Overlay Eq.~\eqref  {eq:ffNumericalPrediction} only with a reported calibrated or fitted $\epsilon $; label a fitted curve as such. If the horizontal axis uses cycles per unit length, convert with $k=2\pi f$. This placeholder contains no simulated data.}}{17}{figure.caption.10}\protected@file@percent }
\newlabel{fig:ffStructureFactor}{{4}{17}{Reserved for the structure factor at the parameters of Fig.~\ref {fig:ffSnapshot}. Use $S(\mathbf k)=N^{-1}\langle |\sum _j e^{-\mathrm i\mathbf k\cdot \mathbf r_j}|^2\rangle $ for nonzero periodic wavevectors $\mathbf k=2\pi (n_x,n_y)/L$. Radial bins should average per-mode values, not sum them: in two dimensions a shell sum can itself introduce a factor proportional to $k$. State the time averaging, bin widths, uncertainty estimates, and fitted wave-number interval. Overlay Eq.~\eqref {eq:ffNumericalPrediction} only with a reported calibrated or fitted $\epsilon $; label a fitted curve as such. If the horizontal axis uses cycles per unit length, convert with $k=2\pi f$. This placeholder contains no simulated data}{figure.caption.10}{}}
